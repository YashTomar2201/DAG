// =============================================================================
// DAG Engine — Prisma Schema
// Canonical data model per PROJECT_GUIDE.md §6.
//
// Key invariants enforced at the DB level:
//   @@unique([runId, nodeKey]) on NodeRun — makes double-execution impossible
//   WorkflowVersion is immutable — edits create a new version, runs pin a version
//   RunEvent is append-only — never update or delete; it is the audit trail
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// Maps to NodeStatusSchema in @dag/contracts.
/// Only legal transitions: PENDING→QUEUED→RUNNING→SUCCEEDED|FAILED|QUEUED(retry)
///                         PENDING|QUEUED→CANCELLED, PENDING→SKIPPED
enum NodeStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

/// Maps to RunStatusSchema in @dag/contracts.
enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

// ─── Models ─────────────────────────────────────────────────────────────────

/// Top-level namespace for isolating workflows per customer/team.
model Tenant {
  id        String     @id @default(cuid())
  name      String
  /// Roadmap C2.3 — max NodeRuns this tenant may have QUEUED/RUNNING across
  /// the whole cluster at once, enforced by a Redis semaphore in
  /// `dispatchNode` (see `packages/queue/src/tenant-quota.ts`). Not RLS-
  /// protected (roadmap C2.1 scoped RLS to Workflow/Run/NodeRun/RunEvent) —
  /// reading a tenant's own quota by its own id needs no tenant context.
  concurrencyLimit Int        @default(20)
  workflows        Workflow[]
  apiKeys          ApiKey[]
}

/// Roadmap A3 — a bearer credential that resolves to a tenant. The raw key is
/// shown to the caller exactly once (at creation); only its SHA-256 `hash` is
/// stored, so a stolen database dump can't be turned back into working keys.
/// `revokedAt` (rather than deleting the row) keeps a revoked key's audit
/// trail — which tenant it belonged to, when it was created — intact.
model ApiKey {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  hash      String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// A named workflow container. Mutable (name can change). Graph versions are
/// immutable snapshots stored on WorkflowVersion.
///
/// `deletedAt` — soft delete. Runs reference immutable versions, so a hard
///               delete would either cascade away run history or fail on the
///               FK. Every list/read query filters `deletedAt: null`; the runs
///               of a deleted workflow stay readable by id.
model Workflow {
  id        String            @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime          @default(now())
  deletedAt DateTime?
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  versions  WorkflowVersion[]
  schedules Schedule[]
  triggers  Trigger[]

  /// Keeps the tenant-scoped, newest-first list query fast.
  @@index([tenantId, createdAt])
}

/// A cron schedule that starts a run on a fixed cadence (roadmap B2).
///
/// Pins the *workflow*, not a version: each fire resolves the workflow's
/// latest version, so "run this every night" keeps tracking your edits. The
/// authoritative timer is a BullMQ Job Scheduler keyed by this row's id
/// (`scheduler` queue) — this row is the user-facing mirror plus the
/// bookkeeping the fire handler needs (`lastRunId` / `lastFiredAt`).
model Schedule {
  id          String    @id @default(cuid())
  workflowId  String
  cron        String // standard 5-field cron, e.g. "0 2 * * *"
  timezone    String    @default("UTC")
  enabled     Boolean   @default(true)
  lastRunId   String? // Run started by the most recent fire
  lastFiredAt DateTime?
  nextFireAt  DateTime? // cached from cron-parser for display; not load-bearing
  createdAt   DateTime  @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id])

  @@index([workflowId])
  @@index([enabled, nextFireAt])
}

/// A webhook endpoint that starts a run when it receives a valid POST
/// (roadmap B2). `token` is the public path segment (`POST /triggers/:token`);
/// `secret` signs the HMAC-SHA256 the caller must send in `X-Signature-256`.
/// The run's idempotency key is `sha256(rawBody)`, so replaying the exact same
/// body is a no-op — it returns the run the first delivery created.
model Trigger {
  id          String    @id @default(cuid())
  workflowId  String
  token       String    @unique
  secret      String
  enabled     Boolean   @default(true)
  lastRunId   String?
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id])

  @@index([workflowId])
}

/// An immutable snapshot of a graph at a point in time.
/// Runs always reference a version, never the mutable Workflow — this ensures
/// the control plane can replay or inspect any historical run exactly as it ran.
///
/// `graph`     — raw { nodes, edges } JSON snapshot (NodeDef[], EdgeDef[])
/// `topoOrder` — { order: string[], tiers: string[][] } cached from Kahn's.
///               Pre-computing at version-creation time means the scheduler
///               never has to recompute topology under load.
model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  version    Int
  graph      Json     // { nodes: NodeDef[], edges: EdgeDef[] }
  topoOrder  Json     // { order: string[], tiers: string[][] }
  createdAt  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id])
  runs     Run[]

  /// Composite unique prevents two versions with the same number for one workflow
  @@unique([workflowId, version])
}

/// One execution of a WorkflowVersion.
///
/// `idempotencyKey` — caller-supplied key so retried HTTP requests return the
///                    existing run rather than spawning a duplicate.
///
/// Fan-out run tree (roadmap B3): a `flow.map` node spawns one child Run per
/// element of its input array. `parentRunId` points a child at the run that
/// spawned it; `fanOutIndex` is that child's position in the source array
/// (stable ordering for the reduce step). Both are null for an ordinary run.
model Run {
  id                String      @id @default(cuid())
  workflowVersionId String
  /// Denormalised from WorkflowVersion -> Workflow.tenantId (roadmap C2.1) —
  /// Row-Level Security needs this column directly on the table it protects;
  /// a policy can't reach through two joins. Set once at creation, never
  /// changed (a Run's tenant can't move).
  tenantId          String
  status            RunStatus   @default(PENDING)
  idempotencyKey    String?     @unique
  triggeredBy       String      // userId, 'schedule', 'api', 'webhook', 'fanout'
  startedAt         DateTime?
  finishedAt        DateTime?

  parentRunId String?
  fanOutIndex Int?
  parent      Run?  @relation("RunTree", fields: [parentRunId], references: [id])
  children    Run[] @relation("RunTree")

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id])
  nodeRuns        NodeRun[]
  events          RunEvent[]

  /// Hot query for the fan-out join: "how many children of X are still running?"
  @@index([parentRunId, status])
  @@index([tenantId])
}

/// One execution of one node inside a Run. This is the atomic unit of work
/// that a BullMQ job maps to.
///
/// Critical invariants:
///   @@unique([runId, nodeKey])  — DB-level backstop against double-execution.
///     Even if the Redis dispatch guard misbehaves, Postgres will reject a
///     second INSERT for the same (runId, nodeKey) pair.
///
///   `attempt` — incremented on each retry so the deterministic jobId
///     `{runId}:{nodeKey}:{attempt}` is unique across retries.
///
///   `input` / `output` — small JSON ≤ 64 KB. Large data goes to ARTIFACT_DIR
///     and is referenced by URI in the output object.
model NodeRun {
  id             String     @id @default(cuid())
  runId          String
  /// Denormalised from Run.tenantId (roadmap C2.1) — see the note on Run.tenantId.
  tenantId       String
  nodeKey        String     // stable user-facing key, e.g. "preprocess"
  status         NodeStatus @default(PENDING)
  attempt        Int        @default(0)
  input          Json?      // fully-resolved inputs (set at dispatch time)
  output         Json?      // executor output (set on SUCCEEDED)
  error          Json?      // { message, stack, retryable } (set on FAILED)
  workerId       String?    // which worker process handled this execution
  leaseExpiresAt DateTime?  // BullMQ lock expiry — used for stalled detection
  startedAt      DateTime?
  finishedAt     DateTime?

  run Run @relation(fields: [runId], references: [id])

  /// The anti-duplicate-execution invariant — see PROJECT_GUIDE.md §6
  @@unique([runId, nodeKey])
  /// Hot query for the orchestrator: "which nodes in run X are still pending?"
  @@index([runId, status])
  @@index([tenantId])
}

/// Append-only audit log. Every state transition and log chunk lands here.
/// Also the replay source for SSE reconnects (via Last-Event-ID cursor).
///
/// `id` BigInt autoincrement — monotonically increasing, safe to use as a cursor.
/// `nodeKey` nullable — run-level events (RUN_STARTED, RUN_SUCCEEDED) omit it.
model RunEvent {
  id        BigInt   @id @default(autoincrement())
  runId     String
  /// Denormalised from Run.tenantId (roadmap C2.1) — see the note on Run.tenantId.
  tenantId  String
  nodeKey   String?
  type      String   // matches RUN_EVENT_TYPES in @dag/contracts
  payload   Json
  createdAt DateTime @default(now())

  run Run @relation(fields: [runId], references: [id])

  /// Efficient tail query for SSE: WHERE runId = ? AND id > cursor ORDER BY id
  @@index([runId, id])
  @@index([tenantId])
}
