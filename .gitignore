# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment — NEVER commit secrets
.env
.env.local
.env.*.local

# Artifact storage (large data outputs, referenced by URI)
artifacts/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code — local, machine-specific
.claude/settings.local.json
.claude/launch.json

# Prisma generated client (regenerated by `prisma generate`)
packages/db/src/generated/
# NOTE: packages/db/prisma/migrations/ is deliberately NOT ignored — the SQL
# migration history is committed so `prisma migrate deploy` rebuilds the schema
# deterministically on a fresh database. Never add it here.

# Logs
*.log
npm-debug.log*
