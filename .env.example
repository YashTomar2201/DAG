# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://dag:dag_secret@localhost:5432/dag_engine"

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ───────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── Artifacts ─────────────────────────────────────────────────────────────────
# Shared volume path where workers write large outputs (datasets, weights, etc.)
ARTIFACT_DIR="./artifacts"

# ─── Worker ────────────────────────────────────────────────────────────────────
# Number of concurrent jobs per worker process (io: 8, cpu: 4, gpu: 1 recommended)
WORKER_CONCURRENCY=4

# ─── Misc ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
