# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://dag:dag_secret@localhost:5432/dag_engine"

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ───────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── Artifacts ─────────────────────────────────────────────────────────────────
# Shared volume path where workers write large outputs (datasets, weights, etc.)
ARTIFACT_DIR="./artifacts"

# ─── Worker ────────────────────────────────────────────────────────────────────
# Concurrency is per QUEUE, not one number for the whole worker — a worker
# process runs one BullMQ Worker per queue (io/cpu/gpu), each with its own
# concurrency (apps/worker/src/worker.ts). GPU is 1 on purpose: one physical
# GPU can only run one CUDA job at a time. Only read as a fallback default;
# tune per-deployment via the per-queue variables below.
WORKER_CONCURRENCY=4
IO_CONCURRENCY=8
CPU_CONCURRENCY=4
GPU_CONCURRENCY=1

# Per-process Prisma connection pool size. Every worker process opens its
# own PrismaClient with its own pool; Postgres's max_connections is a
# shared, finite budget divided across every process that opens one — see
# knowledge_base/decisions_log.md Phase 12 "Prisma connection_limit" for the
# exhaustion this exists to prevent. Kept small for workers (which mostly do
# one conditional UPDATE at a time); a process fielding much more concurrent
# DB traffic (like the Phase 12 scale-test script) overrides this higher.
DB_POOL_SIZE=5

# ─── Misc ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
