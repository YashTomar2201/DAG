# syntax=docker/dockerfile:1
#
# Multi-stage build for the data plane (apps/worker).
#
# Same tsx-at-runtime and `pnpm deploy` rationale as Dockerfile.api — see that
# file's header for both.
#
# Python: as of roadmap phase A1 the executor scripts (apps/worker/python/*.py)
# do real work — they import pandas / scikit-learn / joblib. Those wheels are
# glibc-only (there are no musl builds), so this image is Debian-based
# (node:22-slim), unlike Dockerfile.api which stays on Alpine. The Python deps
# are installed into a venv in the runtime stage from
# apps/worker/python/requirements.txt; PATH is prepended with the venv so
# python-bridge.ts's `spawn('python3', ...)` resolves to it with no code change.
#
# Runtime-stage layer ordering matters: the pip install (pandas/scikit-learn/
# scipy/numpy/pyarrow — ~1 min of PyPI downloads) copies ONLY
# requirements.txt and runs BEFORE `COPY --from=deploy /out ./`. If the app
# code were copied first, every worker source edit (TS or python/*.py) would
# bust the COPY layer and force a full wheel re-download. Keyed on
# requirements.txt alone, the heavy layer stays cached until deps actually
# change.
#
# Why the WHOLE chain (fetch -> build -> deploy -> runtime) is on one libc:
# native modules compiled during `build` (the Prisma query engine,
# msgpackr-extract, ...) are copied verbatim into `runtime` by
# `COPY --from=deploy`. A musl binary cannot load in a glibc image, so runtime
# must match the stage that built those binaries.
#
# process.cwd() note (unchanged): `pnpm --filter @dag/worker deploy` copies
# apps/worker's own directory contents (including python/) to /out, and the
# runtime WORKDIR is that same root — so python-bridge.ts finds python/ (and
# python/requirements.txt) with no path juggling.

FROM node:22-slim AS base
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable && corepack prepare pnpm@11.6.0 --activate
WORKDIR /app
ENV CI=true

FROM base AS fetch
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

FROM fetch AS build
# build-essential + python3 so any native dependency without a prebuilt Debian
# binary can still compile from source during `pnpm install`.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential python3 \
 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN pnpm install --offline --frozen-lockfile
RUN pnpm --filter @dag/db exec prisma generate --schema=./prisma/schema.prisma

FROM build AS deploy
RUN pnpm --filter @dag/worker deploy --prod --legacy /out

FROM base AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip \
 && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
# Python deps first, keyed only on requirements.txt so the wheel-download layer
# survives worker source changes. Isolated in a venv because Debian blocks a
# bare `pip install` ("externally-managed-environment"); the PATH prepend makes
# `python3` resolve to this interpreter.
COPY apps/worker/python/requirements.txt ./python/requirements.txt
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/pip install --no-cache-dir -r python/requirements.txt
ENV PATH="/opt/venv/bin:${PATH}"
# App code last — edits here reuse the pip layer above. `/out` also carries its
# own identical python/requirements.txt, which harmlessly overwrites the copy.
COPY --from=deploy /out ./
CMD ["node_modules/.bin/tsx", "src/index.ts"]
