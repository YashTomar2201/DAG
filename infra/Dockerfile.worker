# syntax=docker/dockerfile:1
#
# Multi-stage build for the data plane (apps/worker).
#
# Same tsx-at-runtime and `pnpm deploy` rationale as Dockerfile.api — see
# that file's header for both.
#
# Python: the executor scripts (apps/worker/python/*.py — preprocess.py,
# train.py, evaluate.py) are pure-stdlib fixtures (no pandas/torch import —
# see knowledge_base/decisions_log.md Phase 8/12 for why: they exist to
# exercise the real Node<->Python bridge and the worker's idempotency/
# heartbeat machinery under test and load, not to run real ML). Only the
# `python3` interpreter itself is installed here. A deployment that swaps in
# real pandas/torch-based scripts would add
# `RUN pip3 install --no-cache-dir -r requirements.txt` right after the
# `apk add` line below — deliberately not done here, since shipping multi-
# gigabyte PyTorch wheels for scripts that never import torch would bloat
# this image for zero functional benefit.
#
# process.cwd() matters here: python-bridge.ts resolves the script directory
# as `path.resolve(process.cwd(), 'python')`. `pnpm --filter @dag/worker
# deploy` copies apps/worker's own directory contents (including python/)
# to the deploy target's root, and the runtime stage's WORKDIR is that same
# root — so `python/` lands exactly where the worker looks for it with no
# extra path juggling.

FROM node:22-alpine AS base
RUN apk add --no-cache openssl && corepack enable && corepack prepare pnpm@11.6.0 --activate
WORKDIR /app
ENV CI=true

FROM base AS fetch
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

FROM fetch AS build
COPY . .
RUN pnpm install --offline --frozen-lockfile
RUN pnpm --filter @dag/db exec prisma generate --schema=./prisma/schema.prisma

FROM build AS deploy
RUN pnpm --filter @dag/worker deploy --prod --legacy /out

FROM base AS runtime
RUN apk add --no-cache python3
ENV NODE_ENV=production
COPY --from=deploy /out ./
CMD ["node_modules/.bin/tsx", "src/index.ts"]
